# ---- Auth (frontends) ----
# Troque o segredo em produção (qualquer string longa e aleatória).
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MIN=720
DEMO_USERNAME=medico
DEMO_PASSWORD=cardioia123

# ---- Auth (dispositivo IoT / emulador) ----
# Token estático usado pelo Wokwi e pelo emulador no POST /telemetry.
DEVICE_TOKEN=wokwi-dev-token

# ---- LLM (Fase 5) ----
# Chave do Google AI Studio (free tier). Vazio => /chat usa resposta de fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- CORS ----
# Lista separada por vírgula. Em produção use o domínio da Vercel.
# Ex.: https://cardioia.vercel.app,https://cardioia-git-main.vercel.app
CORS_ORIGINS=*

# ---- Banco ----
# Fallback local, usado quando ORACLE_* não estiver preenchido:
DATABASE_URL=sqlite:///./cardioia.db

# Oracle Autonomous DB via python-oracledb (thin mode, SEM wallet).
# ORACLE_DSN = string de conexão TLS do console OCI (protocol=tcps).
# NÃO commitar credenciais reais — preencha apenas no .env (git-ignored).
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
