[Unit]
Description=CardioIA Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
# Path do deploy atual (clone em ~/git). Ajuste se mover o projeto.
WorkingDirectory=/home/ubuntu/git/fiap-ano2-fase7/backend
# Sem EnvironmentFile: a app carrega o .env do WorkingDirectory via pydantic-settings,
# evitando o parser do systemd com a senha/DSN do Oracle cheios de caracteres especiais.
# Escuta só em localhost: o cloudflared expõe via HTTPS (sem abrir portas na OCI).
ExecStart=/home/ubuntu/git/fiap-ano2-fase7/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
